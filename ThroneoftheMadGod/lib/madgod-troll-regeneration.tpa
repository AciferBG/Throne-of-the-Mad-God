    LPF ADD_SPELL_EFFECT
        INT_VAR opcode = 143 target = 1 power = 0 parameter1 = 0 parameter2 = 0 timing = 4 resist_dispel = 0 duration = 20 probability1 = 100 probability2 = 0 dicenumber = 0 dicesize = 0 savingthrow = 0 savebonus = 0 special = 0 insert_point = (0 - 1)
        STR_VAR resource = ~MONHP1~
    END
    LPF ADD_SPELL_EFFECT
        INT_VAR opcode = 39 target = 1 power = 0 parameter1 = 0 parameter2 = 1 timing = 0 resist_dispel = 0 duration = 20 probability1 = 100 probability2 = 0 dicenumber = 0 dicesize = 0 savingthrow = 0 savebonus = 0 special = 14 insert_point = (0 - 1)
        STR_VAR resource = ~TROLLDE~
    END
    LPF ADD_SPELL_EFFECT
        INT_VAR opcode = 17 target = 1 power = 0 parameter1 = 100 parameter2 = 2 timing = 4 resist_dispel = 0 duration = 20 probability1 = 100 probability2 = 0 dicenumber = 0 dicesize = 0 savingthrow = 0 savebonus = 0 special = 0 insert_point = (0 - 1)
        STR_VAR resource = ~reg1hp2~
    END
    LPF ADD_SPELL_EFFECT
        INT_VAR opcode = 143 target = 1 power = 0 parameter1 = 7 parameter2 = 0 timing = 4 resist_dispel = 0 duration = 20 probability1 = 100 probability2 = 0 dicenumber = 0 dicesize = 0 savingthrow = 0 savebonus = 0 special = 0 insert_point = (0 - 1)
        STR_VAR resource = ~AC#FRRG~
    END
    LPF ADD_SPELL_EFFECT
        INT_VAR opcode = 17 target = 2 power = 0 parameter1 = 1 parameter2 = 1 timing = 1 resist_dispel = 0 duration = 0 probability1 = 100 probability2 = 0 dicenumber = 0 dicesize = 0 savingthrow = 0 savebonus = 0 special = 0 insert_point = (0 - 1)
        STR_VAR resource = ~~
    END


// Patch only shipped mod templates, and only exact inventory references.
ACTION_BASH_FOR ~%MOD_FOLDER%/cre~ ~.*\.[Cc][Rr][Ee]~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%BASH_FOR_FILE%~ BEGIN
        COPY_EXISTING ~%BASH_FOR_FILE%~ ~override~
            READ_LONG 0x2bc ac_tr_items
            READ_LONG 0x2c0 ac_tr_count
            FOR (ac_tr_i=0; ac_tr_i<ac_tr_count; ++ac_tr_i) BEGIN
                READ_ASCII (ac_tr_items + ac_tr_i*0x14) ac_tr_item (8) NULL
                PATCH_IF ~%ac_tr_item%~ STRING_EQUAL_CASE ~TROLLREG~ BEGIN
                    WRITE_ASCII (ac_tr_items + ac_tr_i*0x14) ~AC#TRRG~ #8
                END
                PATCH_IF ~%ac_tr_item%~ STRING_EQUAL_CASE ~CDHGTRL~ BEGIN
                    WRITE_ASCII (ac_tr_items + ac_tr_i*0x14) ~AC#FRRG~ #8
                END
            END
        BUT_ONLY
    END
END
ACTION_BASH_FOR ~%MOD_FOLDER%/cre/copy~ ~.*\.[Cc][Rr][Ee]~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%BASH_FOR_FILE%~ BEGIN
        COPY_EXISTING ~%BASH_FOR_FILE%~ ~override~
            READ_LONG 0x2bc ac_tr_items
            READ_LONG 0x2c0 ac_tr_count
            FOR (ac_tr_i=0; ac_tr_i<ac_tr_count; ++ac_tr_i) BEGIN
                READ_ASCII (ac_tr_items + ac_tr_i*0x14) ac_tr_item (8) NULL
                PATCH_IF ~%ac_tr_item%~ STRING_EQUAL_CASE ~TROLLREG~ BEGIN
                    WRITE_ASCII (ac_tr_items + ac_tr_i*0x14) ~AC#TRRG~ #8
                END
                PATCH_IF ~%ac_tr_item%~ STRING_EQUAL_CASE ~CDHGTRL~ BEGIN
                    WRITE_ASCII (ac_tr_items + ac_tr_i*0x14) ~AC#FRRG~ #8
                END
            END
        BUT_ONLY
    END
END
