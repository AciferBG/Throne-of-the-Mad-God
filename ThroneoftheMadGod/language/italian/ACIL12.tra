@5202 = ~Perrrché torrrce accesa? Torrrce brrrucia! Torrrce fa male!~
@5203 = ~Urrrsummnogh dice ssserve luce, cossì piccoli amici non cadono in trrrappole dei nani.~
@5204 = ~Perrrché non rrrompere trrrappole come altrrre trrrappole dei nani?~
@5205 = ~Urrrsummnogh dice trrrappole imporrrtanti, uccidono avventurrrrieri.~
@5206 = ~Ma trrrappole fanno male anche a noi!~
@5207 = ~Trrrappole non uccidono noi! Trrroll forrrti! Tu parrrli come debole!~
@5208 = ~DEBOLE? Io ti mossstro chi è debole!~
@5209 = ~Sssilenzio! Ci sssono intrrrusi!~
@5210 = ~Io ti abbatto facile! Tu avere pelle morbida da elfo! Io la ssstrrrappo a pezzi!~
