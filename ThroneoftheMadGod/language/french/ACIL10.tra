@4750 = ~Vous pas aller plus loin ! Vous pas bienvenus. Cette terre appartenir géants et trolls !~
@4751 = ~Dégage, sale gobelin !~
@4752 = ~Des géants ? Des trolls ? Et toi, tu te classes dans quelle catégorie ?~
@4753 = ~Et moi, je suis le roi d'Athkatla. Maintenant, écarte-toi !~ ~Et moi, je suis la reine d'Athkatla. Maintenant, écarte-toi !~
@4754 = ~Nous devons passer par ici pour poursuivre notre mission. Laisse-nous passer, s'il te plaît.~
@4755 = ~Moi seulement serviteur de grands maîtres ! Et grands maîtres pas aimer petit <PRO_RACE> comme toi !~
@4756 = ~Toi aussi bête que tous autres aventuriers ! Toi mourir comme eux ! Hahaha !~
@4757 = ~Toi être sur terre des trolls et géants ! C'est pourquoi toi mourir !~ [verbee01]
@4758 = ~Je croyais que c'était une terre naine ?~
@4759 = ~Impressionnant : un verbeeg qui essaie de se donner de l'importance. Maintenant, écarte-toi avant que je ne t'enfonce ta propre lance dans la gorge !~
@4760 = ~Pardonne-moi d'avoir pénétré sur vos terres. Je vais repartir immédiatement.~
@4761 = ~Non, non ! Tout terre troll et géant maintenant ! Nains tous partis, disparus ! Toi bientôt parti aussi... ou écrasé !~
@4762 = ~*Toi*, tu es le maître de ces terres ?~
@4763 = ~Tu ne nous fais pas peur.~
@4764 = ~Nous allons passer, et personne ne nous en empêchera. Si tu es malin, tu vas t'écarter maintenant.~
@4765 = ~Non, non, moi pas maître ! Moi servir grand maître, beaucoup plus fort que moi ! Toi déranger lui, toi gros ennuis !~
@4766 = ~Nous n'avons peur ni de toi ni de ton maître.~
@4767 = ~Nous allons passer, et personne, pas même ton maître, ne nous en empêchera. Si tu es malin, écarte-toi maintenant.~
@4768 = ~On dirait qu'il va falloir te donner une leçon. Ton maître pourra ramasser ce qu'il restera de toi.~
@4769 = ~Moi pas malin ! Moi pas m'écarter !~
@4770 = ~Moi écraser vous et apporter vos têtes à mon maître !~
@4771 = ~Comme c'est fascinant ! Une variété de troll que je n'avais encore jamais vue ! Quelle regrettable lacune dans l'étendue pourtant irréprochable de mes connaissances.~
@4772 = ~Qu'est-ce que tu es... un troll-cochon ? Un troll-lapin ? Un troll-poulet ?~
@4773 = ~Tu parles de moi ?~
@4774 = ~Un troll ? Où ça ?~
@4775 = ~Je ne tolérerai pas cette insulte !~
@4776 = ~Pour ce manque de respect, je vais te tuer !~
@4777 = ~Stupéfiant. Tu as réussi, je ne sais comment, à être encore plus stupide que tu n'en as l'air !~
@4778 = ~Hein ?~
@4779 = ~Qui êtes-vous ?~
@4780 = ~Qui d'autre ? Ou bien vois-tu un autre <PRO_RACE> à l'esprit aussi lent et au crâne aussi épais dans les parages ?~
@4781 = ~Qu'est-ce que vous faites ici ?~
@4782 = ~Moi, je vois un mage stupide et arrogant qui va bientôt apprendre les bonnes manières !~
@4783 = ~Ce n'était pas une insulte, mais un fait. J'aurais peut-être dû éviter de discuter et simplement te rôtir avec une Flèche de feu ?~
@4784 = ~Tu me facilites vraiment la tâche : je vais pouvoir t'offrir une mort douloureuse !~
@4785 = ~Je suis Glouris Mristifos, membre des illustres Mages du Ciel zhentarims ! Je ne suis venu dans cet endroit misérable que parce que j'ai été choisi pour sélectionner de nouvelles races de trolls destinées au programme d'élevage de Château-Zhentil. Certainement pas pour perdre mon temps avec quelque <PRO_RACE> sans cervelle.~
@4786 = ~Les Zhentarims ? C'est presque aussi mauvais que les Magiciens Rouges !~
@4787 = ~Presque, très cher. Presque.~
@4788 = ~Vous n'êtes qu'un frimeur arrogant.~
@4789 = ~Avez-vous trouvé quelque chose d'intéressant ici ?~
@4790 = ~Les Zhentarims élèvent des trolls ?~
@4791 = ~Vous êtes avec les Zhentarims ? Alors je vais m'occuper de vous tout de suite !~
@4792 = ~Nous le ferons, une fois que nous aurons trouvé les bons spécimens. Mais pour cela, il faut que je m'aventure plus loin dans ces ruines.~
@4793 = ~Je viens à peine d'arriver ici avec ma chimère, maintenant que ces brutes lanceuses de pierres sont mortes. Et au lieu de trolls, je tombe sur vous !~
@4794 = ~Vous êtes venu ici à dos de chimère ?~
@4795 = ~Qu'est-ce qu'une chimère ?~
@4796 = ~Enchanté. Jusqu'à présent, je n'ai eu affaire qu'à des trolls dans les environs.~
@4797 = ~Vous allez bientôt rejoindre ces brutes lanceuses de pierres — dès que j'en aurai fini avec vous, vous aussi !~
@4798 = ~Bien sûr que je suis arrogant ! Je suis un mage puissant ! Je peux écraser n'importe quel adversaire avec mon sort Main broyeuse de Bigby !~
@4799 = ~Je n'ai pas besoin d'un sort pour ça.~
@4800 = ~Moi, je préfère la Gifle annihilatrice de <CHARNAME>.~
@4801 = ~Ne pouvons-nous pas régler cela pacifiquement ?~
@4802 = ~Vous voulez me défier ? Très bien !~
@4803 = ~Euh... quoi ? Oh, c'était censé être une plaisanterie ? Hahaha ! Imbécile. Ton existence même m'offense. Il est temps d'y remédier.~
@4804 = ~Tu ne sais même pas ce qu'est une chimère ? Pathétique ! Très bien, alors tu mourras dans l'ignorance.~
@4805 = ~Oui, et tu vas bientôt faire la connaissance de ma monture !~
@4806 = ~Non, impossible. Où irions-nous si la rumeur se répandait qu'on peut bavarder tranquillement avec un Zhent ?~
@4807 = ~Très bien, donnez tout ce que vous avez !~
@4808 = ~Parce que maintenant, je vais vous montrer ce qu'on fait aux gens comme vous à Château-Zhentil ! Chimère, à moi ! L'heure du festin est venue !~
@4809 = ~Tu n'as jamais entendu parler du troll-<PRO_RACE> ? Une race rare : plus intelligente que les autres, plus meurtrière que les plus redoutables, et deux fois plus charmante !~
